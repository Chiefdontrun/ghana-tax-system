# =============================================================================
# Ghana Tax System — backend environment template
# Copy to .env and fill values. Active vs legacy is marked per variable.
# Keep Vercel project env in parity with this file (same keys).
# Python runtime for Vercel: see runtime.txt (python-3.12 — intentional; do not
# bump to 3.14 without re-validating Django 4.2 template context / tests).
# =============================================================================

# ─── Database (ACTIVE) ───────────────────────────────────────────────────────
# Primary data store. Local: mongodb://localhost:27017/ghana_tax_db
# Atlas: mongodb+srv://...  (Vercel may use MONGODB_URI alias instead)
MONGO_URI=mongodb://localhost:27017/ghana_tax_db
# Optional Vercel alias (settings reads MONGODB_URI OR MONGO_URI)
# MONGODB_URI=
MONGO_DB_NAME=ghana_tax_db

# ─── Cache / sessions (ACTIVE) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# False = prefer LocMem when Redis down (local dev). Production: True + real Redis.
USE_REDIS_CACHE=False
# Reports summary Redis TTL (seconds), default 45
REPORTS_CACHE_TTL=45

# ─── JWT (ACTIVE) ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-use-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Django (ACTIVE) ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=changeme-use-a-long-random-string-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex list for preview deploys (ACTIVE; default in settings covers *.vercel.app)
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ─── Email / admin OTP (ACTIVE — Resend) ─────────────────────────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
# Optional SMTP-style vars (only if EMAIL_BACKEND is SMTP)
# EMAIL_BACKEND=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=

# ─── Demo seed admins (ACTIVE for seed_demo_data) ────────────────────────────
SEED_ADMIN_EMAIL=charweteytettey@gmail.com
SEED_ADMIN_PASSWORD=DemoPass123!

# ─── Paystack MoMo (ACTIVE path when key set — SANDBOX / TEST MODE ONLY) ─────
# Use sk_test_ / pk_test_ only. Not production-ready:
# - AirtelTigo never live-verified against Paystack
# - OTP-relay UX depends on Paystack charge status
# - Prefer Paystack Ghana magic test number 0551234987 for E2E SUCCESS
PAYSTACK_SECRET_KEY=sk_test_key_value
PAYSTACK_PUBLIC_KEY=pk_test_key_value
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Arkesel SMS (ACTIVE SMS provider when ARKESEL_SMS_API_KEY is non-empty) ──
# TIN SMS, trader OTP SMS, payment receipts.
# USSD shortcode *928*309# is configured in Arkesel dashboard separately
# (callback URL → https://<host>/ussd/callback/) — no ARKESEL_USSD env var.
# Sender ID (e.g. GHREVENUE) must be approved in Arkesel for Ghana delivery;
# API may return success while handset delivery waits on sender approval.
ARKESEL_SMS_API_KEY=
ARKESEL_SENDER_ID=GHREVENUE

# ─── Brevo SMS (INACTIVE — class kept in providers/brevo.py, NOT selected) ───
# NotificationService selects Arkesel → Stub only. These vars do nothing
# unless selection code is changed again.
BREVO_API_KEY=
BREVO_SMS_API_KEY=
BREVO_SMS_SENDER=GH-REVENUE

# ─── Africa's Talking (LEGACY / DEPRECATED for SMS) ──────────────────────────
# Provider class still on disk (providers/africas_talking.py) but NOT selected
# by NotificationService. Safe to leave empty. USSD uses Arkesel JSON adapter
# (legacy AT form-encoded still supported for old unit tests only).
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=GH-REVENUE

# ─── Cron / payment safety net (ACTIVE if set) ───────────────────────────────
# Shared secret for pending-payment poller HTTP triggers. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Example value shape (DO NOT reuse this sample in production):
#   CRON_SECRET=60190f3095d599ac2c64cbaf43776ae337c6580f91b8ad30876d9f63eff12160
# Set the SAME value in Vercel env vars and in your external scheduler headers.
#
# Preferred endpoint (external cron every 5 min):
#   POST https://<your-api-host>/api/tax/payments/run-pending-check/
#   Header: X-Cron-Secret: <CRON_SECRET>
#
# Alternate (Vercel Hobby daily cron, GET):
#   GET  https://<your-api-host>/api/cron/check-pending-payments/
#   Header: X-Cron-Secret: <CRON_SECRET>
#   (or Authorization: Bearer <CRON_SECRET>)
#
# Never log or commit the real secret.
CRON_SECRET=
