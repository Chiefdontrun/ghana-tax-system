# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ghana_tax_db
MONGO_DB_NAME=ghana_tax_db

# ─── Cache / Sessions ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Set to False to use in-memory cache when Redis is not running locally
USE_REDIS_CACHE=False
# Reports summary cache TTL in seconds
REPORTS_CACHE_TTL=45

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changeme-use-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=changeme-use-a-long-random-string-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Arkesel SMS (ACTIVE / primary) ───────────────────────────────────────────
# Used for TIN, trader OTP, payment receipts when non-empty.
# USSD gateway remains Arkesel (*928*309#) separately from this SMS key.
ARKESEL_SMS_API_KEY=
ARKESEL_SENDER_ID=GH-REVENUE

# ─── Brevo SMS (INACTIVE — code kept, not selected) ───────────────────────────
# Present for future use only. NotificationService does NOT select Brevo.
# Ghana alphanumeric sender registration blocked prior use.
BREVO_API_KEY=
BREVO_SMS_API_KEY=
BREVO_SMS_SENDER=GH-REVENUE

# ─── Africa's Talking (INACTIVE — unused) ─────────────────────────────────────
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=GH-REVENUE

# ─── Demo Seed Accounts ───────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=charweteytettey@gmail.com
SEED_ADMIN_PASSWORD=DemoPass123!

RESEND_API_KEY=re_test_key_value

DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ─── Paystack ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_key_value
PAYSTACK_PUBLIC_KEY=pk_test_key_value
